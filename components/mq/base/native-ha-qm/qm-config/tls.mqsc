DEFINE QLOCAL('QUEUE1') DEFPSIST(YES) REPLACE 
DEFINE QLOCAL('QUEUE2') DEFPSIST(YES) REPLACE
DEFINE QLOCAL('QUEUE3') DEFPSIST(YES) REPLACE

DEFINE QLOCAL('ORDER') DEFPSIST(YES) REPLACE 
DEFINE QLOCAL('ORDERLOG') REPLACE
ALTER QLOCAL('ORDER') STRMQOS(BESTEF) STREAMQ('ORDERLOG')

DEFINE CHANNEL(HAQMCHL) CHLTYPE(SVRCONN) TRPTYPE(TCP) SSLCAUTH(OPTIONAL) SSLCIPH('ANY_TLS12_OR_HIGHER') REPLACE
SET CHLAUTH(HAQMCHL) TYPE(BLOCKUSER) USERLIST('nobody') ACTION(ADD)
    
DEFINE CHANNEL(METRICS) CHLTYPE(SVRCONN) TRPTYPE(TCP) SSLCAUTH(OPTIONAL) REPLACE
SET CHLAUTH(METRICS) TYPE(BLOCKUSER) USERLIST('nobody') ACTION(ADD)

DEFINE CHANNEL(KAFKA) CHLTYPE(SVRCONN) TRPTYPE(TCP) SSLCAUTH(OPTIONAL) REPLACE
SET CHLAUTH(KAFKA) TYPE(BLOCKUSER) USERLIST('nobody') ACTION(ADD)

* Channel and permissions for IBM MQ Agent MCP Server
DEFINE CHANNEL(AGENT.SVRCONN) CHLTYPE(SVRCONN) TRPTYPE(TCP) SSLCAUTH(OPTIONAL) SSLCIPH('ANY_TLS12_OR_HIGHER') REPLACE
SET CHLAUTH(AGENT.SVRCONN) TYPE(BLOCKUSER) USERLIST('nobody') ACTION(ADD)
SET AUTHREC PROFILE('SYSTEM.DEFAULT.MODEL.QUEUE') OBJTYPE(QUEUE) PRINCIPAL('mqagent') AUTHADD(DSP, INQ)
SET AUTHREC PROFILE('**') OBJTYPE(QUEUE) PRINCIPAL('mqagent') AUTHADD(DSP, INQ)
SET AUTHREC PROFILE('**') OBJTYPE(CHANNEL) PRINCIPAL('mqagent') AUTHADD(DSP, INQ)
SET AUTHREC PROFILE('**') OBJTYPE(QMGR) PRINCIPAL('mqagent') AUTHADD(DSP, INQ)