DEFINE QLOCAL('MQ.QUEUE') DEFPSIST(YES) REPLACE 

DEFINE QLOCAL('MQ.QUEUE.STREAMINGQ') REPLACE
ALTER QLOCAL('MQ.QUEUE') STRMQOS(BESTEF) STREAMQ('MQ.QUEUE.STREAMINGQ')

DEFINE CHANNEL(SICHL) CHLTYPE(SVRCONN) TRPTYPE(TCP) SSLCAUTH(OPTIONAL) REPLACE
SET CHLAUTH(SICHL) TYPE(BLOCKUSER) USERLIST('nobody') ACTION(ADD)

* Channel and permissions for IBM MQ Agent MCP Server
DEFINE CHANNEL(AGENT.SVRCONN) CHLTYPE(SVRCONN) TRPTYPE(TCP) SSLCAUTH(OPTIONAL) SSLCIPH('ANY_TLS12_OR_HIGHER') REPLACE
SET CHLAUTH(AGENT.SVRCONN) TYPE(BLOCKUSER) USERLIST('nobody') ACTION(ADD)
SET AUTHREC PROFILE('SYSTEM.DEFAULT.MODEL.QUEUE') OBJTYPE(QUEUE) PRINCIPAL('mqagent') AUTHADD(DSP, INQ)
SET AUTHREC PROFILE('**') OBJTYPE(QUEUE) PRINCIPAL('mqagent') AUTHADD(DSP, INQ)
SET AUTHREC PROFILE('**') OBJTYPE(CHANNEL) PRINCIPAL('mqagent') AUTHADD(DSP, INQ)
SET AUTHREC PROFILE('**') OBJTYPE(QMGR) PRINCIPAL('mqagent') AUTHADD(DSP, INQ)
